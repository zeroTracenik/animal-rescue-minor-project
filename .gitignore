# ==============================================================================
# Animal Rescue Connect - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
package-lock.json.backup

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime User Uploads (preserve directory structure via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary and Scratch Files
tmp/
temp/
*.tmp
